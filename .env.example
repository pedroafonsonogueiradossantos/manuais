# Copie para .env e ajuste. O .env nunca deve ser commitado.

# Porta do Postgres exposta pelo docker-compose na máquina local.
POSTGRES_PORT=5432

DATABASE_URL=postgres://manuais:manuais@localhost:5432/manuais?sslmode=disable
# Usado só pelos testes de integração (make teste).
TEST_DATABASE_URL=postgres://manuais:manuais@localhost:5432/manuais_teste?sslmode=disable

# Endereço em que a API escuta.
HTTP_ADDR=:8080

# Obrigatório, mínimo de 32 caracteres. Gere com: openssl rand -base64 48
JWT_SECRET=

# Google Drive. Sem estas duas variáveis a API sobe, mas as rotas de arquivo
# respondem 503.
# Caminho do JSON da service account. Fica só no servidor, fora do repositório.
GOOGLE_APPLICATION_CREDENTIALS=
# ID da pasta raiz dos manuais (o trecho depois de /folders/ na URL do Drive).
DRIVE_ROOT_FOLDER_ID=

# IPs/CIDRs de proxies reversos confiáveis, separados por vírgula. Vazio = a API
# ignora X-Forwarded-For.
TRUSTED_PROXIES=
